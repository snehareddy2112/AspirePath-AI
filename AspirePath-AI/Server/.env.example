# AspirePath AI Server Environment Variables

# Server Configuration
PORT=5000
NODE_ENV=production

# Frontend URL (for CORS validation)
FRONTEND_URL=http://localhost:5173

# Database Connection
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# Authentication
JWT_SECRET=your_jwt_secret_key_here

# AI & Third-Party APIs
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
YOUTUBE_API_KEY=your_youtube_data_api_v3_key_here
NEWS_API_KEY=your_news_api_key_here

# JDoodle Code Compiler API
JDOODLE_CLIENT_ID=your_jdoodle_client_id_here
JDOODLE_CLIENT_SECRET=your_jdoodle_client_secret_here

# Email / Nodemailer Configuration
EMAIL_USER=your_email@example.com
EMAIL_PASS=your_email_app_password_here
